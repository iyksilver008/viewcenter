{
  "expo": {
    "name": "ViewCenter",
    "slug": "viewcenter",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.viewcenter.app"
    },
    "ios": {
      "bundleIdentifier": "com.viewcenter.app"
    }
  }
}
