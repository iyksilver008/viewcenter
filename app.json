{
  "expo": {
    "name": "ViewCenter",
    "slug": "viewcenter",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/viewcenter.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/viewcenter.png",
        "backgroundColor": "#ffffff"
      }
    }
  }
}
